{
	"schemaVersion": 1,
	"id": "earshot",
	"version": "${version}",
	"name": "Earshot",
	"description": "Physically based acoustics for the game's own sounds: occlusion, sound around corners, raytraced reverb and HRTF. Client only.",
	"license": "MIT OR Apache-2.0",
	"contact": {
		"homepage": "https://github.com/cumsauce/earshot",
		"sources": "https://github.com/cumsauce/earshot",
		"issues": "https://github.com/cumsauce/earshot/issues"
	},
	"environment": "client",
	"entrypoints": {
		"client": [
			"io.github.cumsauce.earshot.EarshotClient"
		],
		"modmenu": [
			"io.github.cumsauce.earshot.ui.ModMenuEntry"
		]
	},
	"mixins": [
		"earshot.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	},
	"breaks": {
		"sound_physics_remastered": "*"
	},
	"suggests": {
		"yakvc": "*"
	}
}
